{
    "name": "blackcube/starter",
    "description": "Blackcube CMS starter",
    "keywords": [
        "cms",
        "demo",
        "blackcube"
    ],
    "type": "project",
    "license": "BSD-3-Clause",
    "readme": "README.md",
    "homepage": "https://github.com/blackcubeio/starter",
    "support": {
        "issues": "https://github.com/blackcubeio/starter/issues",
        "source": "https://github.com/blackcubeio/starter"
    },
    "authors": [
        {
            "name": "Philippe Gaultier",
            "email": "philippe@blackcube.io"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "blackcube/dboard": "^1.0",
        "blackcube/dcore": "^1.0",
        "blackcube/graphql": "^1.0",
        "blackcube/ssr": "^1.0",
        "blackcube/yii-assets": "^1.0",
        "blackcube/yii-proxy-middleware": "^1.0",
        "httpsoft/http-message": "^1.1",
        "vlucas/phpdotenv": "^5.6",
        "yiisoft/aliases": "^3.1",
        "yiisoft/cache-redis": "^2.0",
        "yiisoft/config": "^1.6",
        "yiisoft/data": "^2.0",
        "yiisoft/data-response": "^2.2",
        "yiisoft/db": "^2.0",
        "yiisoft/db-migration": "^2.0",
        "yiisoft/db-mysql": "^2.0",
        "yiisoft/definitions": "^3.4",
        "yiisoft/di": "^1.4",
        "yiisoft/error-handler": "^4.3",
        "yiisoft/event-dispatcher": "^1.1",
        "yiisoft/factory": "^1.3",
        "yiisoft/input-http": "^1.0",
        "yiisoft/log": "^2.2",
        "yiisoft/log-target-file": "^3.1",
        "yiisoft/rbac-db": "^2.1",
        "yiisoft/router": "^4.0",
        "yiisoft/router-fastroute": "^4.0",
        "yiisoft/test-support": "^3.2",
        "yiisoft/yii-console": "^2.4",
        "yiisoft/yii-http": "^1.1",
        "yiisoft/yii-runner-console": "^2.2",
        "yiisoft/yii-runner-http": "^3.2",
        "yiisoft/yii-view-renderer": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-devel": "1.x-dev"
        },
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        }
    }
}
